{
  "routes": [
    {
      "src": "^/sitemap\\.xml$",
      "has": [{ "type": "host", "value": "labs.sammii.dev" }],
      "dest": "/labs/sitemap.xml"
    },
    {
      "src": "^/robots\\.txt$",
      "has": [{ "type": "host", "value": "labs.sammii.dev" }],
      "dest": "/labs/robots.txt"
    },
    {
      "src": "^/explorations/?$",
      "has": [{ "type": "host", "value": "labs.sammii.dev" }],
      "dest": "/labs/explorations/"
    },
    {
      "src": "^/explorations/(.*)$",
      "has": [{ "type": "host", "value": "labs.sammii.dev" }],
      "dest": "/labs/explorations/$1"
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "labs.sammii.dev"
        }
      ],
      "dest": "/labs/"
    },
    {
      "src": "^/charts/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "labs.sammii.dev"
        }
      ],
      "dest": "/labs/charts/$1"
    },
    {
      "handle": "filesystem"
    }
  ],
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh"
}
